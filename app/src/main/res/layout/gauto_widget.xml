<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/gauto_widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gauto · Сегодня"
        android:textColor="#FFF7F8FC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="всё спокойно"
        android:textColor="#FF22D3EE"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="будильников нет"
        android:textColor="#FFC7D0E4"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_focus"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/gauto_widget_button"
            android:gravity="center"
            android:text="Фокус 25"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/gauto_widget_button"
            android:gravity="center"
            android:text="Сон"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_quiet"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/gauto_widget_button"
            android:gravity="center"
            android:text="Тишина"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
